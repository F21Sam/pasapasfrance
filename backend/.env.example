# ══════════════════════════════════════════════
# Variables d'environnement – PasàPasFrance API
# Copier ce fichier en .env et remplir les valeurs
# NE PAS committer .env sur GitHub !
# ══════════════════════════════════════════════

# ── Base de données PostgreSQL (Render) ──
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pasapasfrance"

# ── JWT ──
JWT_SECRET="remplacer_par_une_cle_secrete_longue_et_aleatoire"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="remplacer_par_une_autre_cle_secrete"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Serveur ──
PORT=3000
NODE_ENV="development"

# ── CORS – URL du frontend ──
FRONTEND_URL="http://localhost:5173"

# ── Notion (CMS) ──
NOTION_API_KEY="secret_xxxxxxxxxxxxxxxxxx"
NOTION_DATABASE_ID="xxxxxxxxxxxxxxxxxx"

# ── Upload ──
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=5242880
