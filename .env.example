# ══════════════════════════════════════════════════
# Variables d'environnement – PasàPasFrance
# Copier en .env et remplir les valeurs
# NE PAS committer .env sur GitHub !
# ══════════════════════════════════════════════════

# ── PostgreSQL ──
POSTGRES_USER=ppf_user
POSTGRES_PASSWORD=ppf_password
POSTGRES_DB=pasapasfrance

# ── JWT ──
JWT_SECRET=remplacer_par_cle_secrete_longue
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=remplacer_par_autre_cle_secrete
JWT_REFRESH_EXPIRES_IN=7d

# ── App ──
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── n8n ──
N8N_USER=admin
N8N_PASSWORD=admin123
N8N_API_SECRET=secret_n8n_pour_api

# ── SMTP (Gmail ou autre) ──
# Pour Gmail : activer "Mots de passe d'application" dans le compte Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASS=mot_de_passe_application_gmail
SMTP_SENDER=noreply@pasapasfrance.fr
